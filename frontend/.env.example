# Frontend Environment Variables
# All variables are OPTIONAL — the code has working defaults built in.
# Copy this file to .env.local to override any default.

# Cloudinary cloud name used to build lesson video URLs (default: dwcxvaswf)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dwcxvaswf

# R2 public bucket base URL for lesson videos (default: https://pub-79bbe5625f3e4375a961f7bf776b47c8.r2.dev)
NEXT_PUBLIC_R2_LESSONS_BASE_URL=https://pub-79bbe5625f3e4375a961f7bf776b47c8.r2.dev
